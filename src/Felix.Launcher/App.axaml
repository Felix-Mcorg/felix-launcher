<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Felix.Launcher.App"
             RequestedThemeVariant="Dark">

  <!-- Couleurs du launcher : pour changer le look, modifie ces valeurs. -->
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#5b8cff" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7da3ff" />
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#33446f" />
    <SolidColorBrush x:Key="CardBrush" Color="#1a1e27" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#272c38" />
    <SolidColorBrush x:Key="TileBrush" Color="#222735" />
    <SolidColorBrush x:Key="TileHoverBrush" Color="#2c3345" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8b93a3" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Cartes arrondies -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="18" />
    </Style>

    <!-- Textes -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>

    <!-- Gros bouton Jouer -->
    <Style Selector="Button.play">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="24,14" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.play:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentDisabledBrush}" />
      <Setter Property="Foreground" Value="#aab4d4" />
    </Style>

    <!-- Petits boutons discrets -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="{DynamicResource TileBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TileHoverBrush}" />
    </Style>

    <!-- Boutons ronds de la barre des serveurs (+ et -) -->
    <Style Selector="Button.rail">
      <Setter Property="Width" Value="52" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="Background" Value="{DynamicResource TileBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TileHoverBrush}" />
    </Style>

    <!-- Liste des serveurs : des pastilles carrées, la sélectionnée est cerclée de la couleur d'accent -->
    <Style Selector="ListBox.rail">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.rail ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="CornerRadius" Value="18" />
    </Style>
    <Style Selector="ListBox.rail ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ListBox.rail ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TileHoverBrush}" />
    </Style>

    <!-- Liste des fichiers -->
    <Style Selector="ListBox.files">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.files ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Barre de progression fine, couleur d'accent -->
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="MinHeight" Value="8" />
      <Setter Property="Height" Value="8" />
    </Style>
  </Application.Styles>
</Application>
